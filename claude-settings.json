{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "theme": "dark",
  "autoUpdatesChannel": "stable",
  "autoMemoryDirectory": "~/.claude-memory/memory",
  "permissions": {
    "allow": [],
    "ask": ["Read(//**/.env)", "Edit(//**/.env)"],
    "deny": [
      "Read(~/.snowflake/**)", "Edit(~/.snowflake/**)",
      "Read(~/.ssh/**)", "Edit(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)", "Read(~/.git-credentials)",
      "Bash(gh auth token)", "Bash(gh auth token *)", "Bash(gh auth status *-t*)",
      "Bash(kubectl *get *secret*)", "Bash(kubectl *describe *secret*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.local/bin/claude-memory-sync\" start" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.local/bin/claude-memory-sync\" push-async" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.local/bin/claude-memory-sync\" push-async" }
        ]
      }
    ]
  }
}
