#!/usr/bin/env zsh
#
# claude-memory-sync | https://github.com/fernandoataoldotcom/github_dotfiles
#
# Keeps Claude Code's memory (a PRIVATE git repo cloned at ~/.claude-memory, see
# `autoMemoryDirectory` in ~/.claude/settings.json) in sync across throwaway VMs.
# Wired to Claude Code hooks: SessionStart -> start, Stop/SessionEnd -> push-async.
#
# The same repo also holds private per-project notes (projects/<owner>/<repo>.md):
# what a CLAUDE.md would say, for repos whose owners do not want one committed.
# `start` prints them, and Claude Code adds a SessionStart hook's stdout to the
# session's context, so nothing is ever written into the project repo. In a folder
# holding several clones, `start` prints only an index, and `touch` (a PreToolUse
# hook) adds a repo's notes the first time the session reads, edits or runs a
# command in it.
#
#   claude-memory-sync start        pull, then print the notes for the repo in $PWD
#                                   (or an index of the repos up to two levels inside
#                                   $PWD), print today's priority (or tell the session to
#                                   ask for it first), and flag a Claude Code update no
#                                   VM has seen
#   claude-memory-sync notes        print the notes (or the index) only
#   claude-memory-sync touch        PreToolUse hook: add the notes for a repo the tool
#                                   call works in, once per session, and log the load
#   claude-memory-sync pull         commit local changes, then rebase onto the remote
#   claude-memory-sync push         commit local changes, rebase, push
#   claude-memory-sync push-async   same as push, detached (hooks must return fast)
#
# CLAUDE_MEMORY_SURFACE (Code, UI or Duet) names the Claude surface running the sync.
# The memory repo's rule: every commit names its surface in git's committer name and
# as a subject prefix. Code keeps the user as author; UI and Duet author their own
# commits. The Claude Code hooks in claude-settings.json set Code.
#
# Never fails, and only `start`/`notes` print on stdout: a sync problem must not
# block a session, and hook stdout ends up in Claude's context.

DIR="${CLAUDE_MEMORY_DIR:-$HOME/.claude-memory}"
LOCK="${DIR}/.git/claude-memory-sync.lock"

warn() { print -r -- "claude-memory-sync: $*" >&2; }
# Fresh VMs may not have a git identity yet; never let that drop a memory. Commits
# AND rebases need one, so it applies to every git call. `touch` never commits and
# runs before every tool call, so it skips the lookup.
IDENT=()
[[ "${1:-}" == touch || -n "$(git -C "$DIR" config user.email 2>/dev/null)" ]] \
  || IDENT=(-c user.name=claude-memory-sync -c user.email=claude-memory-sync@localhost)
g()    { GIT_TERMINAL_PROMPT=0 timeout 20 git -C "$DIR" "${IDENT[@]}" "$@"; }

# Exported, not passed to `commit` only: `pull --rebase` re-commits local commits
# with the current committer, which would drop the surface's name.
SURFACE="${CLAUDE_MEMORY_SURFACE:-}"
case "$SURFACE" in
  (Code)    export GIT_COMMITTER_NAME="Claude Code" ;;
  (UI|Duet) export GIT_COMMITTER_NAME="Claude ${SURFACE}" GIT_AUTHOR_NAME="Claude ${SURFACE}" ;;
  (*)       SURFACE="" ;;
esac
NO_SURFACE="CLAUDE_MEMORY_SURFACE is '${CLAUDE_MEMORY_SURFACE:-}', not Code, UI or Duet"
# Every sync, not only one that commits: a rebase also re-commits earlier local commits.
surface_warn() { [[ -n "$SURFACE" ]] || warn "${NO_SURFACE}; commits and rebased commits will not name a surface."; }

commit_local() {
  g add -A >/dev/null 2>&1
  g diff --cached --quiet >/dev/null 2>&1 && return 0
  g commit --quiet -m "${SURFACE:+${SURFACE}: }memory: ${HOST:-unknown} $(date -u +%Y-%m-%dT%H:%M:%SZ)" 2>/dev/null \
    || warn "commit failed; changes stay in the working tree."
}

rebase_on_remote() {
  g pull --rebase --autostash --quiet 2>/dev/null && return 0
  g rebase --abort 2>/dev/null
  return 1
}

pull() {
  surface_warn
  commit_local
  rebase_on_remote || warn "pull failed (offline, empty remote or conflict); using the local copy."
}

push() {
  surface_warn
  commit_local
  g rev-parse --verify -q HEAD >/dev/null 2>&1 || return 0        # nothing committed yet
  # Cheap exit for the common case (runs after every turn): nothing new to send.
  if g rev-parse --verify -q '@{u}' >/dev/null 2>&1; then
    [[ -z "$(g rev-list '@{u}..HEAD' 2>/dev/null)" ]] && return 0
    rebase_on_remote || { warn "rebase onto remote failed; keeping the local commit for next time."; return 0; }
  fi
  g push --quiet -u origin HEAD 2>/dev/null || warn "push failed; will retry on the next sync."
}

# <owner>/<repo> for the git repo at $1, from its origin; empty if it has none.
# Lowercased: GitHub names are case-insensitive, and origins spell them both ways.
repo_key() {
  local url; url="$(git -C "$1" remote get-url origin 2>/dev/null)" || return 0
  url="${url%.git}"
  local -a parts=("${(@s:/:)${url//://}}")
  (( ${#parts} >= 2 )) || return 0
  local key="${parts[-2]//[^A-Za-z0-9._-]/_}/${parts[-1]//[^A-Za-z0-9._-]/_}"
  print -r -- "${(L)key}"
}

# Claude Code caps a hook's context text at 10,000 characters and swaps anything
# longer for a file path and a 2,000-character preview it never asks Claude to read.
# Long notes are cut at a line and point to the file, leaving room for the rest of
# the hook's output.
NOTES_MAX=8000
notes_text() {
  local f="${DIR}/projects/$1.md" body
  body="$(<"$f")"
  if (( ${#body} > NOTES_MAX )); then
    body="${body[1,NOTES_MAX]}"; body="${body%$'\n'*}"
    body+=$'\n'"[Cut at ${NOTES_MAX} characters. Read ${f} for the rest before changing anything in this repo.]"
  fi
  print -r -- "===== Notes for $1 ====="
  print -r -- "$body"
}

# First line of a notes file that is not blank or a heading, for the index.
summary() {
  local line
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    (( ${#line} > 160 )) && line="${line[1,157]}..."
    print -r -- "$line"; return
  done < "$1"
}

# Per-session record of the repos whose notes are already in context, one file per
# repo root. Session ids come from hook input, so only safe characters pass.
SESSIONS="${XDG_CACHE_HOME:-$HOME/.cache}/claude-memory-sync/sessions"
session_dir() { [[ "$1" =~ '^[A-Za-z0-9_-]+$' ]] && print -r -- "${SESSIONS}/$1"; }
mark() { [[ -n "$1" ]] && mkdir -p "$1" 2>/dev/null && print -r -- "$3" > "$1/${2//\//%}"; }

# One line per notes load, in one file per host and month so VMs never conflict.
# Synced with the rest of the repo; it shows whether the lazy loading misses repos.
log_load() {
  local host="${${HOST:-unknown}//[^A-Za-z0-9._-]/_}" d="${DIR}/logs/notes-loads"
  mkdir -p "$d" 2>/dev/null || return 0
  print -r -- "$(date -u +%Y-%m-%dT%H:%M:%SZ)	${host}	${SURFACE:-none}	${3[1,8]}	$1	$2" \
    >> "$d/${host}-$(date -u +%Y-%m).log"
}

# Notes for the git repo containing $PWD. When $PWD is not in a repo (a workspace
# folder holding several clones), an index of the repos one or two levels inside it
# (clones are often grouped by owner: <owner>/<repo>): their full notes would pass
# the context cap, so `touch` adds each one when the session starts working in it.
# $1: the session's marker directory, when called from the SessionStart hook.
notes() {
  local -a dirs=(); local inrepo=0
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    dirs=("${$(git rev-parse --show-toplevel):A}"); inrepo=1
  else
    dirs=(*/.git(N:h:A) */*/.git(N:h:A)); dirs=("${(@)dirs[1,24]}")
  fi
  local d key; local -aU have=() missing=()   # -U: two clones of one repo share notes
  for d in "${dirs[@]}"; do
    [[ -n "$d" ]] || continue
    key="$(repo_key "$d")"; [[ -n "$key" ]] || continue
    if [[ -s "${DIR}/projects/${key}.md" ]]; then have+=("$key"); else missing+=("$key"); fi
  done
  (( ${#have} + ${#missing} )) || return 0
  print -r -- "Private project notes live in ${DIR}/projects/<owner>/<repo>.md (owner and repo in lowercase), outside the project repos and synced across VMs. Treat them like each repo's CLAUDE.md: edit those files to record durable, project-specific instructions (build/test commands, conventions), and never add a CLAUDE.md to a project itself unless asked."
  if (( inrepo )); then
    for key in "${have[@]}"; do
      print -r -- ""
      notes_text "$key"
    done
    mark "$1" "${dirs[1]}" "$key"
  elif (( ${#have} )); then
    print -r -- ""
    print -r -- "Notes for the repos in this folder are not loaded yet. A hook adds a repo's notes to this session the first time you read, edit or run a command in it. If you work in a repo any other way, read its notes file first."
    for key in "${have[@]}"; do
      print -r -- "- ${key}: $(summary "${DIR}/projects/${key}.md") (${DIR}/projects/${key}.md)"
    done
  fi
  if (( ${#missing} )); then
    print -r -- ""
    print -r -- "No notes yet for: ${(j:, :)missing}"
  fi
}

# Nearest directory at or above $1 holding .git (a directory, or a file in worktrees
# and submodules). Plain stat calls: this runs before every tool call.
repo_root() {
  local d="${1:A}"
  while [[ -n "$d" && "$d" != / ]]; do
    [[ -e "$d/.git" ]] && { print -r -- "$d"; return 0; }
    d="${d:h}"
  done
  return 1
}

# PreToolUse hook. Finds the repos a tool call works in (the file a Read, Edit or
# Write names; for Bash, the shell's cwd plus any argument that is a path), and adds
# the notes for each repo this session has not seen yet. Best effort for Bash: a
# command that names a repo only indirectly is missed, so a Bash call that looks like
# a write but resolves to no repo is logged as `Bash-unresolved`.
touch_repo() {
  local -a in=("${(@0)$(jq -j '[.session_id, .tool_name, .cwd, (.tool_input.file_path // ""), (.tool_input.command // "")]
    | map(. // "" | tostring) | join("\u0000")' 2>/dev/null)}")
  # Not `path`: zsh ties it to $PATH.
  local sid="${in[1]}" tool="${in[2]}" cwd="${in[3]}" file="${in[4]}" cmd="${in[5]}"
  local sdir; sdir="$(session_dir "$sid")" || return 0
  [[ -d "$cwd" ]] || cwd="$PWD"
  local -a cands=()
  if [[ -n "$file" ]]; then
    [[ "$file" == /* ]] || file="${cwd}/${file}"
    cands=("$file")
  elif [[ "$tool" == Bash ]]; then
    cands=("$cwd")
    local tok
    for tok in "${(@)${(z)cmd}[1,200]}"; do
      tok="${(Q)tok}"; tok="${tok#*=}"; tok="${tok/#\~/$HOME}"
      [[ -z "$tok" || "$tok" == -* || "$tok" == *://* ]] && continue
      [[ "$tok" == */* || -d "${cwd}/${tok}" ]] || continue
      [[ "$tok" == /* ]] || tok="${cwd}/${tok}"
      cands+=("$tok")
    done
  fi
  local c root key out="" used=0 text; local -aU roots=()
  for c in "${cands[@]}"; do root="$(repo_root "$c")" && roots+=("$root"); done
  if (( ! ${#roots} )) && [[ "$tool" == Bash && "$cmd" =~ '(git (add|commit|push|mv|rm)|sed -i|tee |[^0-9&]>)' ]]; then
    log_load "-" Bash-unresolved "$sid"
  fi
  for root in "${roots[@]}"; do
    [[ -e "${sdir}/${root//\//%}" ]] && continue
    key="$(repo_key "$root")"
    if [[ -z "$key" || ! -s "${DIR}/projects/${key}.md" ]]; then
      mark "$sdir" "$root" "$key"; continue
    fi
    text="$(notes_text "$key")"
    # Two repos in one call could pass the cap together; the rest load on a later call.
    (( used + ${#text} > NOTES_MAX + 1000 )) && continue
    out+="${out:+$'\n\n'}${text}"; (( used += ${#text} ))
    mark "$sdir" "$root" "$key"; log_load "$key" "$tool" "$sid"
  done
  [[ -n "$out" ]] || return 0
  jq -cn --arg ctx "Project notes for a repo this session is now working in:"$'\n\n'"${out}" \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", additionalContext: $ctx}}'
}

# Claude Code's newest version seen by any VM, shared through the memory repo. On a
# newer one, ask Claude to check the changelog for changes to our setup (settings,
# hooks, permissions): a renamed or retired key fails silently. Only moves forward,
# since VMs auto-update on different days. The file is union-merged (.gitattributes),
# so two VMs recording at once can leave two lines: the newest counts.
VERSION_FILE="${DIR}/claude-code-version"
version_check() {
  # Headless runs (claude -p, schedulers) have no reader: leave the alert for a person.
  [[ "${CLAUDE_CODE_SESSION_ATTENDED:-1}" == 0 ]] && return 0
  local now seen
  now="$(claude --version 2>/dev/null)"; now="${now%% *}"
  [[ "$now" == [0-9]* ]] || return 0
  seen="$(sort -V "$VERSION_FILE" 2>/dev/null | tail -1)"
  autoload -Uz is-at-least
  if [[ -n "$seen" ]] && is-at-least "$now" "$seen"; then return 0; fi
  print -r -- "$now" > "$VERSION_FILE"
  [[ -n "$seen" ]] || return 0
  print -r -- ""
  print -r -- "Claude Code was updated from ${seen} to ${now}, a version no VM had run before. At the start of your first reply, read the changelog entries after ${seen} up to ${now} (https://raw.githubusercontent.com/anthropics/claude-code/main/CHANGELOG.md) and tell the user, in a few lines, only the changes that affect this setup: settings keys used in ~/.claude/settings.json (renamed, retired, new defaults), hooks, permission rules, the status line, memory and CLAUDE.md loading, and commit or PR attribution. If nothing affects it, say so in one line."
}

# The user's daily priority is declared in context/topics/current-priority.md in the
# memory repo. A priority not set for today blocks work until the user decides it, and
# an instruction in a file the session may never open fails silently, so say it here.
# When it is set, print it so the session can keep the user on it. The file names the
# time zone its dates use ("- Time zone: ..." under "Today's priority"); without one,
# the VM's local date counts. No file, no output.
PRIORITY_FILE="${DIR}/context/topics/current-priority.md"
priority_check() {
  [[ -r "$PRIORITY_FILE" ]] || return 0
  # Headless runs (claude -p, schedulers) have nobody to ask: they use the standing priority.
  [[ "${CLAUDE_CODE_SESSION_ATTENDED:-1}" == 0 ]] && return 0
  local field tz day date prio
  field() { awk -v h="## Today's priority" -v k="- $1: " \
    '/^## /{s=($0==h)} s && index($0,k)==1 {print substr($0,length(k)+1); exit}' "$PRIORITY_FILE"; }
  tz="$(field 'Time zone')"; date="$(field Date)"; prio="$(field Priority)"
  if [[ -n "$tz" ]]; then day="$(TZ="$tz" date +%F)"; else day="$(date +%F)"; fi
  print -r -- ""
  if [[ "$date" == "$day" && -n "$prio" ]]; then
    print -r -- "Today's priority (${date}, from ${PRIORITY_FILE}): ${prio[1,500]}"
  else
    print -r -- "The user's priority is not set for today (${day}): the Date line under \"Today's priority\" in ${PRIORITY_FILE} says '${date[1,40]:-missing}'. Before starting any work, ask them to decide it: offer the standing priority in that file as the default, and ask what, if anything, outranks it today. Then record the answer under \"Today's priority\" (Date, Priority, Set by). Questions, status checks and farewells are not work."
  fi
}

# One sync at a time; a lock left by a crashed run is cleared after 5 minutes.
locked() {
  [[ -n "$(find "$LOCK" -maxdepth 0 -mmin +5 2>/dev/null)" ]] && rmdir "$LOCK" 2>/dev/null
  mkdir "$LOCK" 2>/dev/null || return 0
  "$@"
  rmdir "$LOCK" 2>/dev/null
}

[[ -d "${DIR}/.git" ]] || exit 0

case "${1:-}" in
  (pull|push) locked "$1" ;;
  (start)
    # SessionStart hook input names the session. A resumed session still holds the
    # notes it loaded; after /clear or a compaction they are gone, so they load again.
    hook_in=""; [[ -t 0 ]] || hook_in="$(timeout 2 cat 2>/dev/null)"
    sdir="$(session_dir "$(jq -r '.session_id // ""' <<<"$hook_in" 2>/dev/null)")"
    if [[ -n "$sdir" ]]; then
      [[ "$(jq -r '.source // ""' <<<"$hook_in" 2>/dev/null)" == resume ]] || rm -rf "$sdir"
      find "$SESSIONS" -mindepth 1 -maxdepth 1 -mtime +7 -exec rm -rf {} + 2>/dev/null
    fi
    locked pull; notes "$sdir"; priority_check; version_check
    # push-async discards stderr, so a hook without a surface would never be noticed.
    if [[ -z "$SURFACE" ]]; then
      print -r -- ""
      print -r -- "claude-memory-sync: ${NO_SURFACE}, so this session's commits to the memory repo will not name their surface as that repo's rules require. Tell the user."
    fi
    ;;
  (notes)     notes ;;
  (touch)     touch_repo ;;
  (push-async)
    if command -v setsid >/dev/null 2>&1; then
      setsid "${0:A}" push </dev/null >/dev/null 2>&1 &!
    else
      "${0:A}" push </dev/null >/dev/null 2>&1 &!
    fi
    ;;
  (*)
    warn "usage: claude-memory-sync start|notes|touch|pull|push|push-async"
    ;;
esac
exit 0
