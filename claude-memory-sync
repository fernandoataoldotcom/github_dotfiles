#!/usr/bin/env zsh
#
# claude-memory-sync | https://github.com/fernandoataoldotcom/github_dotfiles
#
# Keeps Claude Code's memory (a PRIVATE git repo cloned at ~/.claude-memory, see
# `autoMemoryDirectory` in ~/.claude/settings.json) in sync across throwaway VMs.
# Wired to Claude Code hooks: SessionStart -> start, Stop/SessionEnd -> push-async.
#
# The same repo also holds private per-project notes (projects/<owner>/<repo>.md):
# what a CLAUDE.md would say, for repos whose owners do not want one committed.
# `start` prints them, and Claude Code adds a SessionStart hook's stdout to the
# session's context, so nothing is ever written into the project repo.
#
#   claude-memory-sync start        pull, then print the notes for the repo in $PWD
#                                   (or for each repo up to two levels inside $PWD)
#   claude-memory-sync notes        print the notes only
#   claude-memory-sync pull         commit local changes, then rebase onto the remote
#   claude-memory-sync push         commit local changes, rebase, push
#   claude-memory-sync push-async   same as push, detached (hooks must return fast)
#
# Never fails, and only `start`/`notes` print on stdout: a sync problem must not
# block a session, and hook stdout ends up in Claude's context.

DIR="${CLAUDE_MEMORY_DIR:-$HOME/.claude-memory}"
LOCK="${DIR}/.git/claude-memory-sync.lock"

warn() { print -r -- "claude-memory-sync: $*" >&2; }
# Fresh VMs may not have a git identity yet; never let that drop a memory. Commits
# AND rebases need one, so it applies to every git call.
IDENT=()
[[ -n "$(git -C "$DIR" config user.email 2>/dev/null)" ]] \
  || IDENT=(-c user.name=claude-memory-sync -c user.email=claude-memory-sync@localhost)
g()    { GIT_TERMINAL_PROMPT=0 timeout 20 git -C "$DIR" "${IDENT[@]}" "$@"; }

commit_local() {
  g add -A >/dev/null 2>&1
  g diff --cached --quiet >/dev/null 2>&1 && return 0
  g commit --quiet -m "memory: ${HOST:-unknown} $(date -u +%Y-%m-%dT%H:%M:%SZ)" 2>/dev/null \
    || warn "commit failed; changes stay in the working tree."
}

rebase_on_remote() {
  g pull --rebase --autostash --quiet 2>/dev/null && return 0
  g rebase --abort 2>/dev/null
  return 1
}

pull() {
  commit_local
  rebase_on_remote || warn "pull failed (offline, empty remote or conflict); using the local copy."
}

push() {
  commit_local
  g rev-parse --verify -q HEAD >/dev/null 2>&1 || return 0        # nothing committed yet
  # Cheap exit for the common case (runs after every turn): nothing new to send.
  if g rev-parse --verify -q '@{u}' >/dev/null 2>&1; then
    [[ -z "$(g rev-list '@{u}..HEAD' 2>/dev/null)" ]] && return 0
    rebase_on_remote || { warn "rebase onto remote failed; keeping the local commit for next time."; return 0; }
  fi
  g push --quiet -u origin HEAD 2>/dev/null || warn "push failed; will retry on the next sync."
}

# <owner>/<repo> for the git repo at $1, from its origin; empty if it has none.
# Lowercased: GitHub names are case-insensitive, and origins spell them both ways.
repo_key() {
  local url; url="$(git -C "$1" remote get-url origin 2>/dev/null)" || return 0
  url="${url%.git}"
  local -a parts=("${(@s:/:)${url//://}}")
  (( ${#parts} >= 2 )) || return 0
  local key="${parts[-2]//[^A-Za-z0-9._-]/_}/${parts[-1]//[^A-Za-z0-9._-]/_}"
  print -r -- "${(L)key}"
}

# Notes for the git repo containing $PWD. When $PWD is not in a repo (a workspace
# folder holding several clones), notes for each repo one or two levels inside it
# (clones are often grouped by owner: <owner>/<repo>).
notes() {
  local -a dirs=()
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    dirs=("$(git rev-parse --show-toplevel)")
  else
    dirs=(*/.git(N:h) */*/.git(N:h)); dirs=("${(@)dirs[1,24]}")
  fi
  local d key; local -aU have=() missing=()   # -U: two clones of one repo share notes
  for d in "${dirs[@]}"; do
    [[ -n "$d" ]] || continue
    key="$(repo_key "$d")"; [[ -n "$key" ]] || continue
    if [[ -s "${DIR}/projects/${key}.md" ]]; then have+=("$key"); else missing+=("$key"); fi
  done
  (( ${#have} + ${#missing} )) || return 0
  print -r -- "Private project notes live in ${DIR}/projects/<owner>/<repo>.md (owner and repo in lowercase), outside the project repos and synced across VMs. Treat them like each repo's CLAUDE.md: edit those files to record durable, project-specific instructions (build/test commands, conventions), and never add a CLAUDE.md to a project itself unless asked."
  for key in "${have[@]}"; do
    print -r -- ""
    print -r -- "===== Notes for ${key} ====="
    cat "${DIR}/projects/${key}.md"
  done
  if (( ${#missing} )); then
    print -r -- ""
    print -r -- "No notes yet for: ${(j:, :)missing}"
  fi
}

# One sync at a time; a lock left by a crashed run is cleared after 5 minutes.
locked() {
  [[ -n "$(find "$LOCK" -maxdepth 0 -mmin +5 2>/dev/null)" ]] && rmdir "$LOCK" 2>/dev/null
  mkdir "$LOCK" 2>/dev/null || return 0
  "$@"
  rmdir "$LOCK" 2>/dev/null
}

[[ -d "${DIR}/.git" ]] || exit 0

case "${1:-}" in
  (pull|push) locked "$1" ;;
  (start)     locked pull; notes ;;
  (notes)     notes ;;
  (push-async)
    if command -v setsid >/dev/null 2>&1; then
      setsid "${0:A}" push </dev/null >/dev/null 2>&1 &!
    else
      "${0:A}" push </dev/null >/dev/null 2>&1 &!
    fi
    ;;
  (*)
    warn "usage: claude-memory-sync start|notes|pull|push|push-async"
    ;;
esac
exit 0
