#!/usr/bin/env bash
#
# claude-statusline | https://github.com/fernandoataoldotcom/github_dotfiles
# From venkatamutyala/dotfiles v0.6.0 (claude/statusline.sh).
# Copyright (c) 2023 Venkata Mutyala, MIT License: https://github.com/venkatamutyala/dotfiles/blob/v0.6.0/LICENSE
# Installed as ~/.claude/statusline.sh and wired in claude-settings.json.
#
# Claude Code status line: model | dir (branch) | context used
input=$(cat)
command -v jq >/dev/null 2>&1 || { echo "claude (install jq for the status line)"; exit 0; }

model=$(jq -r '.model.display_name // "claude"' <<<"$input")
dir=$(jq -r '.workspace.current_dir // empty' <<<"$input")
ctx=$(jq -r '.context_window.used_percentage // empty' <<<"$input")
branch=$(git -C "${dir:-.}" branch --show-current 2>/dev/null)

out="$model | ${dir##*/}"
[ -n "$branch" ] && out+=" ($branch)"
[ -n "$ctx" ] && out+=" | ctx ${ctx%.*}%"
echo "$out"
